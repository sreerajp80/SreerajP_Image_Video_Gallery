<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and above. allowBackup="false" stops cloud backup there, but it
     does not stop device-to-device transfer, so both are closed here.

     Every storage area is excluded, not just the sensitive files, so a file
     added by a later feature is safe by default. The user's own encrypted
     .gallerybak backup stays the way to move app data to a new phone.
     See docs/security.md, section 10. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
