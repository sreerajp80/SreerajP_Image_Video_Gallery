<?xml version="1.0" encoding="utf-8"?>
<!--
  SreerajP Image Video Gallery - Adaptive Launcher Foreground Icon
  A photo canvas with mountains and sunset, paired with a video play badge.
  Designed for the 108dp x 108dp adaptive icon viewport (72dp safe mask zone).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Soft ambient shadow behind the photo card -->
    <path
        android:fillColor="#30000000"
        android:pathData="M38,30h28a7,7 0 0 1 7,7v28a7,7 0 0 1 -7,7h-28a7,7 0 0 1 -7,-7v-28a7,7 0 0 1 7,-7z" />

    <!-- 2. Photo Card Outer Body / Frame -->
    <path
        android:fillColor="#0D2D45"
        android:strokeColor="#2E8BBF"
        android:strokeWidth="1.6"
        android:pathData="M37,28h28a7,7 0 0 1 7,7v28a7,7 0 0 1 -7,7h-28a7,7 0 0 1 -7,-7v-28a7,7 0 0 1 7,-7z" />

    <!-- 3. Photo Picture Window Background (Night/Twilight Sky) -->
    <path
        android:pathData="M37,31h28a4,4 0 0 1 4,4v23h-36v-23a4,4 0 0 1 4,-4z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="51"
                android:startY="31"
                android:endX="51"
                android:endY="58"
                android:type="linear">
                <item android:offset="0.0" android:color="#061826" />
                <item android:offset="0.6" android:color="#0A2C46" />
                <item android:offset="1.0" android:color="#124468" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. Sun Glow Halo -->
    <path
        android:pathData="M58,32a6.5,6.5 0 1 0 0.01,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="58"
                android:centerY="38.5"
                android:gradientRadius="7"
                android:type="radial">
                <item android:offset="0.0" android:color="#60FFA726" />
                <item android:offset="1.0" android:color="#00FFA726" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 5. Sunset Sun Disk -->
    <path
        android:pathData="M58,34a4.5,4.5 0 1 0 0.01,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="58"
                android:startY="34"
                android:endX="58"
                android:endY="43"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFE082" />
                <item android:offset="0.5" android:color="#FFA726" />
                <item android:offset="1.0" android:color="#FF7043" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 6. Distant Background Mountain Peak -->
    <path
        android:fillColor="#154B68"
        android:pathData="M42,39l10,19h-18l8,-19z" />

    <!-- 7. Main Central Mountain (Left / Lit Ridge) -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M52,41l-4,17h-11l15,-17z" />

    <!-- 8. Main Central Mountain (Right / Shadow Ridge) -->
    <path
        android:fillColor="#0284C7"
        android:pathData="M52,41l13,17h-17l4,-17z" />

    <!-- 9. Foreground Left Peak -->
    <path
        android:fillColor="#0EA5E9"
        android:pathData="M37,46l8,12h-11l3,-12z" />

    <!-- 10. Glowing Valley Stream / Water Reflection -->
    <path
        android:fillColor="#67E8F9"
        android:pathData="M48,53c1,2 0,3 2,5h-2c-2,-2 -1,-3 -2,-5h2z" />

    <!-- 11. Subtle Card Glint / Reflection (Top-Left Bevel) -->
    <path
        android:fillColor="#33FFFFFF"
        android:pathData="M35,28.5h14l-15,15v-11a4,4 0 0 1 4,-4z" />

    <!-- 12. Bottom Card Chin Accent Line -->
    <path
        android:fillColor="#256B96"
        android:pathData="M37,63h18v1.5h-18z" />

    <!-- ======================================================== -->
    <!-- Video Play Badge (Anchored at Bottom-Right of the Frame) -->
    <!-- ======================================================== -->

    <!-- 13. Outer Dark Cutout Ring (Provides separation from photo card) -->
    <path
        android:fillColor="#04121D"
        android:pathData="M66,51a11.5,11.5 0 1 0 0.01,0" />

    <!-- 14. Badge Inner Disc -->
    <path
        android:pathData="M66,52.5a10,10 0 1 0 0.01,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="58"
                android:startY="52"
                android:endX="74"
                android:endY="72"
                android:type="linear">
                <item android:offset="0.0" android:color="#006688" />
                <item android:offset="0.6" android:color="#0B334E" />
                <item android:offset="1.0" android:color="#061B2B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 15. Glowing Badge Rim -->
    <path
        android:strokeColor="#76D1FF"
        android:strokeWidth="1.5"
        android:pathData="M66,52.5a10,10 0 1 0 0.01,0" />

    <!-- 16. Play Triangle (Golden Accent with Rounded Corners) -->
    <path
        android:fillColor="#FFD54F"
        android:strokeColor="#FFE082"
        android:strokeWidth="0.5"
        android:pathData="M63.5,58.2a1,1 0 0 1 1.5,-0.85l6.5,3.75a1,1 0 0 1 0,1.72l-6.5,3.75a1,1 0 0 1 -1.5,-0.85z" />

</vector>
