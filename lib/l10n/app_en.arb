  "helpTopicTimelineTitle": "Timeline & Memories",
  "@helpTopicTimelineTitle": {
    "description": "Title of the timeline help topic"
  },
  "helpTopicTimelineSummary": "Browse photos by date, pinch to change grid size, and view flashbacks.",
  "@helpTopicTimelineSummary": {
    "description": "Summary of timeline help topic"
  },
  "helpTopicTimelineOverview": "The timeline organizes all your indexed photos and videos in reverse chronological order with date headers. It includes an 'On This Day' flashback carousel showing photos from today in past years.",
  "@helpTopicTimelineOverview": {
    "description": "Overview of timeline help topic"
  },
  "helpTopicTimelineSteps": "• Pinch in or out to dynamically switch between 1 and 5 columns.\n• Drag the floating date scrubber on the right to jump quickly through months and years.\n• Tap any photo or video to open it in high resolution.",
  "@helpTopicTimelineSteps": {
    "description": "Steps for timeline help topic"
  },
  "helpTopicTimelineTips": "• Long-press any photo to enter multi-selection mode for batch actions.\n• You can toggle flashback memories on or off in Settings.",
  "@helpTopicTimelineTips": {
    "description": "Tips for timeline help topic"
  },
  "helpTopicTimelinePrivacy": "All timeline grouping and date indexing happen strictly on device using local SQLite. No remote server is ever contacted.",
  "@helpTopicTimelinePrivacy": {
    "description": "Privacy note for timeline help topic"
  },
  "helpTopicViewerTitle": "Fullscreen Viewer & Video Player",
  "@helpTopicViewerTitle": {
    "description": "Title of the viewer help topic"
  },
  "helpTopicViewerSummary": "High-resolution viewer with gestures, EXIF details, and hardware video playback.",
  "@helpTopicViewerSummary": {
    "description": "Summary of viewer help topic"
  },
  "helpTopicViewerOverview": "View photos and videos with smooth hardware acceleration. Swipe through your timeline seamlessly with responsive gesture controls.",
  "@helpTopicViewerOverview": {
    "description": "Overview of viewer help topic"
  },
  "helpTopicViewerSteps": "• Double-tap or pinch to zoom into fine details.\n• Swipe down to dismiss and return to the timeline.\n• Swipe up to view the EXIF metadata drawer (camera, exposure, resolution, location).\n• While watching video: swipe up/down on left for brightness, on right for volume, or swipe horizontally to seek.",
  "@helpTopicViewerSteps": {
    "description": "Steps for viewer help topic"
  },
  "helpTopicViewerTips": "• Use the video controls to adjust playback speed (0.25x to 2.0x), step frame-by-frame, or repeat video in a loop.\n• Tap the overflow menu for quick access to editing, converting, scanning, and notes.",
  "@helpTopicViewerTips": {
    "description": "Tips for viewer help topic"
  },
  "helpTopicViewerPrivacy": "EXIF metadata is parsed and cached locally in SQLite. Video decoding is hardware-accelerated without any network streaming components.",
  "@helpTopicViewerPrivacy": {
    "description": "Privacy note for viewer help topic"
  },
  "helpTopicEditorTitle": "Photo Editor & Markup",
  "@helpTopicEditorTitle": {
    "description": "Title of the photo editor help topic"
  },
  "helpTopicEditorSummary": "Crop, rotate, adjust colors, apply filters, doodle markup, and redact private areas.",
  "@helpTopicEditorSummary": {
    "description": "Summary of photo editor help topic"
  },
  "helpTopicEditorOverview": "A full-featured non-destructive photo editor with transformations, color adjustments, artistic filters, freehand markup, privacy redaction, and watermarking.",
  "@helpTopicEditorOverview": {
    "description": "Overview of photo editor help topic"
  },
  "helpTopicEditorSteps": "• Open any photo and tap the Edit icon in the toolbar.\n• Transform: Crop with standard aspect ratios, rotate quarter turns, flip, or straighten.\n• Adjust: Fine-tune exposure, contrast, highlights, shadows, warmth, and RGB curves.\n• Markup & Redact: Draw shapes, add text, or redact sensitive areas using Gaussian blur, pixelation, or blackout.\n• Tap Save to export.",
  "@helpTopicEditorSteps": {
    "description": "Steps for photo editor help topic"
  },
  "helpTopicEditorTips": "• Privacy redactions permanently replace underlying pixels in the exported image.\n• Full undo and redo history is available throughout the editing session.",
  "@helpTopicEditorTips": {
    "description": "Tips for photo editor help topic"
  },
  "helpTopicEditorPrivacy": "All image operations are performed completely offline on a background isolate. Edits are saved as a new version beside the original, never overwriting your original photo without consent.",
  "@helpTopicEditorPrivacy": {
    "description": "Privacy note for photo editor help topic"
  },
  "helpTopicConverterTitle": "Format Converter & Compression",
  "@helpTopicConverterTitle": {
    "description": "Title of format converter help topic"
  },
  "helpTopicConverterSummary": "Convert formats (JPEG, PNG, WEBP, BMP), compress file sizes, and trim videos.",
  "@helpTopicConverterSummary": {
    "description": "Summary of format converter help topic"
  },
  "helpTopicConverterOverview": "Convert photos between popular image formats, compress file sizes with real-time size estimation, extract still frames from video, convert video clips to GIF, and trim videos losslessly.",
  "@helpTopicConverterOverview": {
    "description": "Overview of format converter help topic"
  },
  "helpTopicConverterSteps": "• Select Convert from the viewer overflow menu.\n• Choose target format (JPEG, PNG, WEBP, BMP) and adjust the quality slider.\n• Set resize mode (percentage, longest side, or custom dimensions) if desired.\n• Tap Convert to generate the optimized file.",
  "@helpTopicConverterSteps": {
    "description": "Steps for format converter help topic"
  },
  "helpTopicConverterTips": "• In Video Tools: Use lossless trimming to cut sections without re-encoding or quality loss.\n• Create animated GIFs from video clips with custom framerate and loop settings.",
  "@helpTopicConverterTips": {
    "description": "Tips for format converter help topic"
  },
  "helpTopicConverterPrivacy": "All image and video conversions take place entirely on-device with zero network transmission. Results are saved as new files.",
  "@helpTopicConverterPrivacy": {
    "description": "Privacy note for format converter help topic"
  },
  "helpTopicPdfTitle": "PDF Export & Image Extraction",
  "@helpTopicPdfTitle": {
    "description": "Title of PDF tools help topic"
  },
  "helpTopicPdfSummary": "Export multi-image PDF documents and extract embedded pictures from PDFs offline.",
  "@helpTopicPdfSummary": {
    "description": "Summary of PDF tools help topic"
  },
  "helpTopicPdfOverview": "Create professional PDF documents from selected photos with custom layouts, or extract high-quality images embedded inside PDF documents.",
  "@helpTopicPdfOverview": {
    "description": "Overview of PDF tools help topic"
  },
  "helpTopicPdfSteps": "• PDF Export: Select photos, choose page size (A4, Letter), orientation, margins, and tap Export.\n• PDF Image Extract: Open the tool from the timeline menu, pick a PDF file, review detected pictures, and tap Save to extract them to your gallery.",
  "@helpTopicPdfSteps": {
    "description": "Steps for PDF tools help topic"
  },
  "helpTopicPdfTips": "• Reorder photos before PDF export to control page sequence.\n• The PDF extractor walks file objects directly, working even if the PDF's cross-reference table is damaged.",
  "@helpTopicPdfTips": {
    "description": "Tips for PDF tools help topic"
  },
  "helpTopicPdfPrivacy": "PDF generation and extraction are executed 100% offline using an app-private sandbox. No PDF data is ever uploaded to any cloud service.",
  "@helpTopicPdfPrivacy": {
    "description": "Privacy note for PDF tools help topic"
  },
  "helpTopicSearchTitle": "Search & Tags",
  "@helpTopicSearchTitle": {
    "description": "Title of search and tags help topic"
  },
  "helpTopicSearchSummary": "Instant SQLite FTS5 search with query filters and 12-color tag management.",
  "@helpTopicSearchSummary": {
    "description": "Summary of search and tags help topic"
  },
  "helpTopicSearchOverview": "Locate photos and videos instantly using full-text search across titles, notes, camera models, and tags, with prefix operators and multi-criteria filters.",
  "@helpTopicSearchOverview": {
    "description": "Overview of search and tags help topic"
  },
  "helpTopicSearchSteps": "• Tap the Search icon on the timeline.\n• Type any search keywords, or use prefixes: 'tag:nature', 'type:video', 'camera:sony', 'place:kochi', 'before:2024-01-01'.\n• Tap the Filter icon to combine date range, media type, favorites, and size filters.\n• To manage tags, visit the Tags screen from the timeline menu.",
  "@helpTopicSearchSteps": {
    "description": "Steps for search and tags help topic"
  },
  "helpTopicSearchTips": "• Create custom tags with 12 distinct Material colors.\n• Tags update the search index immediately, making photos findable in milliseconds.",
  "@helpTopicSearchTips": {
    "description": "Tips for search and tags help topic"
  },
  "helpTopicSearchPrivacy": "Search indexes are stored locally in SQLite with FTS5. Your search queries and history remain strictly on your device.",
  "@helpTopicSearchPrivacy": {
    "description": "Privacy note for search and tags help topic"
  },
  "helpTopicAlbumsTitle": "Albums & Smart Albums",
  "@helpTopicAlbumsTitle": {
    "description": "Title of albums help topic"
  },
  "helpTopicAlbumsSummary": "Organize into virtual albums, browse device folders, and view smart auto-albums.",
  "@helpTopicAlbumsSummary": {
    "description": "Summary of albums help topic"
  },
  "helpTopicAlbumsOverview": "Manage your collection with user-created virtual albums, physical device folder browsing, and smart auto-albums that organize media automatically.",
  "@helpTopicAlbumsOverview": {
    "description": "Overview of albums help topic"
  },
  "helpTopicAlbumsSteps": "• Tap Albums on the timeline app bar.\n• Virtual Albums: Tap '+' to create an album, add media, reorder items, or set a custom cover photo.\n• Smart Albums: Automatically gathers Favorites, Videos, GIFs, RAW photos, Panoramas, and Recently Added.\n• Device Folders: Browse physical folders on your storage (Camera, Screenshots, WhatsApp, Downloads).",
  "@helpTopicAlbumsSteps": {
    "description": "Steps for albums help topic"
  },
  "helpTopicAlbumsTips": "• Pin favorite albums to keep them at the top of the list.\n• Virtual albums do not duplicate media files on disk, saving storage space.",
  "@helpTopicAlbumsTips": {
    "description": "Tips for albums help topic"
  },
  "helpTopicAlbumsPrivacy": "Album memberships and metadata are stored in the local database. Device folder scanning adheres to Android scoped storage.",
  "@helpTopicAlbumsPrivacy": {
    "description": "Privacy note for albums help topic"
  },
  "helpTopicCleanerTitle": "Duplicate Cleaner",
  "@helpTopicCleanerTitle": {
    "description": "Title of duplicate cleaner help topic"
  },
  "helpTopicCleanerSummary": "Detect exact and visually similar duplicates with side-by-side comparison.",
  "@helpTopicCleanerSummary": {
    "description": "Summary of duplicate cleaner help topic"
  },
  "helpTopicCleanerOverview": "Free up storage by identifying exact duplicate files (via SHA-256 hash) and visually similar photos (via perceptual pHash and dHash).",
  "@helpTopicCleanerOverview": {
    "description": "Overview of duplicate cleaner help topic"
  },
  "helpTopicCleanerSteps": "• Open Duplicate Cleaner from the timeline menu.\n• Tap Scan to analyze your library.\n• Review duplicate groups and tap any group for side-by-side comparison.\n• Use 'Keep Best Photo' to automatically pick the highest resolution, sharpest image and move others to trash.",
  "@helpTopicCleanerSteps": {
    "description": "Steps for duplicate cleaner help topic"
  },
  "helpTopicCleanerTips": "• Perceptual hashing finds photos taken in rapid succession or with minor edits.\n• No file is ever deleted without your confirmation.",
  "@helpTopicCleanerTips": {
    "description": "Tips for duplicate cleaner help topic"
  },
  "helpTopicCleanerPrivacy": "Hashing runs completely locally. Downsampled 32x32 previews are used for DCT computation and cleared immediately.",
  "@helpTopicCleanerPrivacy": {
    "description": "Privacy note for duplicate cleaner help topic"
  },
  "helpTopicVaultTitle": "Secure Private Vault",
  "@helpTopicVaultTitle": {
    "description": "Title of vault help topic"
  },
  "helpTopicVaultSummary": "Hardware-backed AES-256-GCM encryption, biometric & PIN authentication, and shredding.",
  "@helpTopicVaultSummary": {
    "description": "Summary of vault help topic"
  },
  "helpTopicVaultOverview": "Protect sensitive photos and videos in an encrypted vault. Payloads are encrypted with a 256-bit key protected by the Android Keystore, with biometric unlock and screenshot prevention.",
  "@helpTopicVaultOverview": {
    "description": "Overview of vault help topic"
  },
  "helpTopicVaultSteps": "• Tap the Vault icon on the timeline to unlock or configure your vault.\n• Set a master PIN (and enable Biometrics for convenient access).\n• Import media from the timeline or viewer. Choose whether to securely shred the original file.\n• View encrypted photos and videos safely inside the vault.",
  "@helpTopicVaultSteps": {
    "description": "Steps for vault help topic"
  },
  "helpTopicVaultTips": "• Screenshot protection (FLAG_SECURE) is active while inside the vault.\n• The vault locks automatically when the app is switched to the background or after an idle timeout.",
  "@helpTopicVaultTips": {
    "description": "Tips for vault help topic"
  },
  "helpTopicVaultPrivacy": "Decrypted data is held in memory only. Keys never leave the Android Keystore hardware module, and no plaintext files are left on disk.",
  "@helpTopicVaultPrivacy": {
    "description": "Privacy note for vault help topic"
  },
  "helpTopicSyncTitle": "Local Wi-Fi Transfer",
  "@helpTopicSyncTitle": {
    "description": "Title of local transfer help topic"
  },
  "helpTopicSyncSummary": "Direct peer-to-peer transfer between devices on the same Wi-Fi with zero internet.",
  "@helpTopicSyncSummary": {
    "description": "Summary of local transfer help topic"
  },
  "helpTopicSyncOverview": "Transfer photos and videos directly between two phones on the same local Wi-Fi router. Connections are end-to-end encrypted with an authenticated handshake.",
  "@helpTopicSyncOverview": {
    "description": "Overview of local transfer help topic"
  },
  "helpTopicSyncSteps": "• On receiving device: Open Transfer > Receive to show the QR pairing code.\n• On sending device: Open Transfer > Send and scan the code (or enter the 6-character code).\n• Select photos or albums to transfer and start the transfer.\n• Received files are verified by SHA-256 digest and published directly to your gallery.",
  "@helpTopicSyncSteps": {
    "description": "Steps for local transfer help topic"
  },
  "helpTopicSyncTips": "• No internet access or router configuration is needed; devices connect directly over local IP addresses.\n• The transfer socket binds only while the transfer screen is open and shuts down immediately when you leave.",
  "@helpTopicSyncTips": {
    "description": "Tips for local transfer help topic"
  },
  "helpTopicSyncPrivacy": "Connections to external or public IP addresses are strictly blocked by LocalAddressRules. Zero tracking, zero telemetry, zero cloud intermediary.",
  "@helpTopicSyncPrivacy": {
    "description": "Privacy note for local transfer help topic"
  },
  "helpTopicBackupTitle": "Backup & Restore",
  "@helpTopicBackupTitle": {
    "description": "Title of backup help topic"
  },
  "helpTopicBackupSummary": "Create password-protected encrypted .gbak archives and restore safely.",
  "@helpTopicBackupSummary": {
    "description": "Summary of backup help topic"
  },
  "helpTopicBackupOverview": "Safeguard your tags, album structures, media notes, and user metadata in an encrypted GBAK backup archive protected by AES-256-GCM.",
  "@helpTopicBackupOverview": {
    "description": "Overview of backup help topic"
  },
  "helpTopicBackupSteps": "• Tap Backup from the timeline menu.\n• Create Backup: Enter a strong password and save the backup file via Android's document picker.\n• Restore: Select a previously exported .gbak file, enter your password, inspect the preview summary, and apply.",
  "@helpTopicBackupSteps": {
    "description": "Steps for backup help topic"
  },
  "helpTopicBackupTips": "• The restore process is non-destructive: it fills gaps and merges tags and albums without overwriting existing data.\n• Keep a safe record of your backup password; without it, the encrypted archive cannot be recovered.",
  "@helpTopicBackupTips": {
    "description": "Tips for backup help topic"
  },
  "helpTopicBackupPrivacy": "Backup files are encrypted using PBKDF2-derived keys and AES-256-GCM. Backups are stored wherever you choose on your device or SD card.",
  "@helpTopicBackupPrivacy": {
    "description": "Privacy note for backup help topic"
  },
  "helpTopicScannerTitle": "QR Scanner & OCR",
  "@helpTopicScannerTitle": {
    "description": "Title of scanner and OCR help topic"
  },
  "helpTopicScannerSummary": "Scan QR/barcodes from photos with safe schemes, and extract text with offline OCR.",
  "@helpTopicScannerSummary": {
    "description": "Summary of scanner and OCR help topic"
  },
  "helpTopicScannerOverview": "Analyze existing photos to scan QR codes and barcodes, or run offline Tesseract optical character recognition to extract English and Malayalam text.",
  "@helpTopicScannerOverview": {
    "description": "Overview of scanner and OCR help topic"
  },
  "helpTopicScannerSteps": "• Open a photo in the viewer and select 'Scan code' or 'Extract text' from the menu.\n• Scanned codes: View detected URL, Wi-Fi credentials, or text. Safe URL schemes (http, https, tel, mailto, sms, geo) can be opened with confirmation.\n• Extracted text: View recognized text, copy it to clipboard, or append it directly to the media item's notes.",
  "@helpTopicScannerSteps": {
    "description": "Steps for scanner and OCR help topic"
  },
  "helpTopicScannerTips": "• Optical character recognition uses bundled offline language models (English and Malayalam); no internet connection is required.\n• Wi-Fi codes allow copying network credentials securely or suggesting network connection without silent joining.",
  "@helpTopicScannerTips": {
    "description": "Tips for scanner and OCR help topic"
  },
  "helpTopicScannerPrivacy": "All barcode decoding and OCR processing are executed locally on your device. Untrusted QR payloads are validated before launching external apps.",
  "@helpTopicScannerPrivacy": {
    "description": "Privacy note for scanner and OCR help topic"
  },
